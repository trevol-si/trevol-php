<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="unitarias">
            <directory>pruebas/Unitarias</directory>
        </testsuite>
        <testsuite name="prism">
            <directory>pruebas/Prism</directory>
        </testsuite>
        <testsuite name="fragmentos">
            <directory>pruebas/Fragmentos</directory>
        </testsuite>
    </testsuites>
</phpunit>
